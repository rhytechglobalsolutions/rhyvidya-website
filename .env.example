# RhyVidya booking form — server-side mail settings (names only, NO values).
#
# Set these in Vercel → rhyvidya-website → Settings → Environment Variables
# (Production + Preview), then redeploy. Never commit real values to the repo.
# The form endpoint is app/api/booking/route.ts; without SMTP_HOST /
# SMTP_USER / SMTP_PASS it answers a graceful "mail not configured" error
# and the form shows its WhatsApp / direct-email fallback.

# SMTP_HOST — outgoing mail server of the sending mailbox
#             (for Zoho Mail, the host shown under Settings → Mail Accounts → SMTP)
SMTP_HOST=

# SMTP_PORT — 465 for implicit TLS (typical for Zoho), or 587 for STARTTLS
SMTP_PORT=

# SMTP_USER — full email address of the mailbox that authenticates and sends
SMTP_USER=

# SMTP_PASS — an app-specific password for SMTP_USER, generated in the mail
#             provider's security settings (never the account's main password)
SMTP_PASS=

# MAIL_TO — inbox that receives website enquiries (defaults to info@rhyvidya.com)
MAIL_TO=

# MAIL_FROM — From address on enquiry emails (defaults to SMTP_USER;
#             must be the mailbox itself or one of its aliases)
MAIL_FROM=
